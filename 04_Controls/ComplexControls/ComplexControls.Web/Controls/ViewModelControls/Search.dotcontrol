@viewModel ComplexControls.Web.Controls.SearchViewModel, ComplexControls.Web

<div class="flex flex-col gap-4">
    <form class="flex flex-row items-center gap-2">
        <dot:TextBox Text="{value: SearchText}" Placeholder="Search..." class="bg-gray-800 text-white border-gray-600 border-2 rounded w-full" />
        <dot:Button Text="Search" IsSubmitButton="true" Click="{command: Search()}" class="mt-2 bg-blue-500 text-white rounded px-4 py-2 hover:bg-blue-600 hover:cursor-pointer" />
    </form>
    <div class="mt-4">
        <p class="mt-4 text-lg font-bold">Search Results:</p>
        <dot:Repeater DataSource={value: SearchResults} >
            <ItemTemplate>
                <div class="mt-2 flex items-center gap-2">
                    <span>{{value: _this}}</span>
                </div>
            </ItemTemplate>
        </dot:Repeater>
    </div>
</div>