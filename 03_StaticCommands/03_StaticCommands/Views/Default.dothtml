@viewModel StaticCommands.ViewModels.DefaultViewModel, StaticCommands
@masterPage Views/MasterPage.dotmaster
@service fileService = StaticCommands.Services.FileService
@import StaticCommands
<dot:Content ContentPlaceHolderID="MainContent">

    <div class="min-h-screen flex bg-gray-900 text-gray-100">

        <!-- Left: file list -->
        <aside class="w-80 shrink-0 p-4 border-r border-gray-700">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold">Files</h2>
                <div class="flex items-center gap-3">
                    <span class="text-sm text-gray-400">{{value: Items.Count}}</span>
                    <dot:Button class="px-2 py-1 rounded-md bg-green-600 hover:bg-green-500 text-white flex items-center gap-1"
                                Click="{staticCommand: IsModalVisible = true; 
                                                       NewFileName = ""; 
                                                       FocusManager.SetFocus("NewFileNameTextBox")}"
                                Validation.Enabled="false"
                                ButtonTagName="button">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Add
                    </dot:Button>
                </div>
            </div>

            <!-- Search box -->
            <form class="mb-3">
                <div class="flex gap-2">
                    <dot:TextBox placeholder="Search files..." 
                                 class="w-full px-3 py-2 rounded-md bg-gray-800 text-gray-100 border border-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" 
                                 Text="{value: SearchText}"/>
                    <dot:Button class="px-3 py-2 rounded-md bg-indigo-600 hover:bg-indigo-500 text-white"
                                Click="{staticCommand: FilteredItems = Items
                                                .Where(i => i.FileName.Contains(SearchText)).ToList()}"
                                IsSubmitButton="true"
                                ButtonTagName="button">Search</dot:Button>
                    <dot:Button class="px-3 py-2 rounded-md bg-gray-600 hover:bg-gray-500 text-white"
                                ButtonTagName="button"
                                Click="{staticCommand: SearchText = ""; FilteredItems = null}">Cancel</dot:Button>
                </div>
            </form>

            <div class="overflow-auto max-h-[calc(100vh-4rem)]">
                <ul class="space-y-2">
                    <dot:Repeater DataSource="{value: FilteredItems ?? Items}">
                        <ItemTemplate>
                            <li>
                                <dot:LinkButton Click="{command: _root.LoadFile(_this)}"
                                                class="block w-full text-left px-3 py-2 rounded-md hover:bg-gray-800 active:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                    <cc:TextHighlight Text="{value: FileName}"
                                                      HighlightedText="{value: _root.SearchText}" />
                                </dot:LinkButton>
                                <%--<dot:LinkButton Click="{staticCommand: _root.FileContents = fileService.LoadFile(_this)}"
                                                class="block w-full text-left px-3 py-2 rounded-md hover:bg-gray-800 active:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                    <cc:TextHighlight Text="{value: FileName}"
                                        HighlightedText="{value: _root.SearchText}" />
                                </dot:LinkButton>--%>
                            </li>
                        </ItemTemplate>
                    </dot:Repeater>
                </ul>
            </div>

            <div class="mt-6 text-xs text-gray-500">
                Tip: click a file to load its contents to the preview on the right.
            </div>
        </aside>

        <!-- Right: code preview -->
        <main class="flex-1 p-6">
            <div class="h-full bg-gradient-to-b from-gray-800 via-gray-900 to-black rounded-lg shadow-inner p-4 overflow-auto max-h-[calc(100vh-4rem)]">
                <div class="mb-3 flex items-baseline justify-between">
                    <h3 class="text-sm text-gray-300">Preview</h3>
                    <span class="text-xs text-gray-500">Rendered as plain text</span>
                </div>

                <div class="prose prose-invert max-w-none">
                    <pre class="whitespace-pre-wrap bg-transparent text-sm font-mono leading-relaxed text-gray-100"
                         >{{value: FileContents}}</pre>
                </div>
            </div>
        </main>

    </div>

    <!-- Modal Dialog for Adding New File -->
    <dot:ModalDialog Open="{value: IsModalVisible}" class="bg-gray-800 rounded-lg shadow-xl p-6 max-w-md border border-gray-700 w-100">
        <div class="flex items-center justify-between mb-4">

            <h3 class="text-xl font-semibold text-gray-100">Create New File</h3>

            <dot:Button class="text-gray-400 hover:text-gray-200"
                        Validation.Enabled="false"
                        Click="{staticCommand: IsModalVisible = false}"
                        ButtonTagName="button">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </dot:Button>

        </div>
            
        <form>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-300 mb-2">File Name</label>
                <dot:TextBox placeholder="Enter file name..." 
                             class="w-full px-3 py-2 rounded-md bg-gray-900 text-gray-100 border border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500" 
                             ID="NewFileNameTextBox"
                             Validator.Value="{value: NewFileName}"
                             Validator.InvalidCssClass="border-red-500 focus:ring-red-500"
                             Text="{value: NewFileName}"/>
            </div>
                
            <div class="flex gap-3 justify-end">
                <dot:Button class="px-4 py-2 rounded-md bg-green-600 hover:bg-green-500 text-white"
                            Click="{staticCommand: fileService.CreateFile(NewFileName); 
                                                   IsModalVisible = false; 
                                                   Items = fileService.GetFiles()}"
                            ButtonTagName="button"
                            IsSubmitButton="true">
                    Create
                </dot:Button>
            </div>
        </form>
    </dot:ModalDialog>

    <div class="fixed right-0 top-0 bg-yellow-100 p-2.5 text-black diag-box hidden"></div>

</dot:Content>
