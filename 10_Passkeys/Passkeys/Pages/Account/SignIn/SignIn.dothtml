@viewModel _10_Passkeys.Pages.Account.SignIn.SignInViewModel, 10_Passkeys
@masterPage Pages/AuthLayout.dotmaster
@service _passkeys = _10_Passkeys.Services.PasskeyService
@js passkeys

<dot:Content ContentPlaceHolderID="MascotSays">
    Hi there! Skip the password &mdash; just sign in with your passkey.
</dot:Content>

<dot:Content ContentPlaceHolderID="MainContent">
    <dot:NamedCommand Name="GetLoginOptions" Command="{staticCommand: _passkeys.GetLoginOptions()}" />
    <dot:NamedCommand Name="CompleteLogin" Command="{staticCommand: (string credentialJson) => _passkeys.CompleteLogin(credentialJson)}" />

    <t:StackLayout Gap="Large">
        <header class="auth-heading">
            <h1>Sign in to your account</h1>
        </header>

        <form class="passkey-cta">
            <t:Button Text="Sign in with a passkey" Type="Primary" Size="Large" Icon="FingerPrint" class="w-full" IsSubmitButton="true" Click="{staticCommand: _js.InvokeAsync("passkeyLogin")}" Validation.Enabled="false" />
            <div class="passkey-status">
                <cc:Mascot class="mascot mascot-framed passkey-status-character" />
                <p data-passkey-status role="status" aria-live="polite" class="bubble bubble-left"></p>
            </div>
        </form>

        <div class="divider"><span>or use your password</span></div>

        <form>
            <t:Form>
                <ContentTemplate>
                    <t:TextBoxFormField LabelText="E-mail address" Text="{value: _root.Form.Email}" Type="Email" />
                    <t:TextBoxFormField LabelText="Password" Text="{value: _root.Form.Password}" Type="Password" />
                    <t:Alert Type="Danger" Text="{value: _root.ErrorMessage}" Visible="{value: _root.ErrorMessage != null}" />
                </ContentTemplate>
                <FooterTemplate>
                    <t:Button Text="Sign in with password" Type="Secondary" class="w-full" IsSubmitButton="true" Click="{command: _root.SignIn()}" Validation.Target="{value: _root.Form}" />
                </FooterTemplate>
            </t:Form>
        </form>

        <p class="auth-switch">
            New here? <dot:RouteLink Text="Create an account" RouteName="CreateAccount" />
        </p>
    </t:StackLayout>
</dot:Content>
