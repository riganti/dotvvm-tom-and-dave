@viewModel _10_Passkeys.Pages.LayoutViewModel, 10_Passkeys

<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{resource: PageTitle}}</title>
    <link rel="icon" type="image/svg+xml" href="/img/mascot.svg" />
    <dot:RequiredResource Name="app.css" />
    <dot:RequiredResource Name="app.js" />
    <dot:HeadResourceLinks />
</head>
<body class="app-shell">

    <t:AppLayout>
        <TopMenuTemplate>
            <t:TopMenu HamburgerPosition="End">
                <StartTemplate>
                    <dot:RouteLink RouteName="Profile" class="brand">
                        <cc:Mascot class="mascot brand-mark" />
                        <span class="brand-name">Passkeys</span>
                        <span class="brand-pill">demo</span>
                    </dot:RouteLink>
                </StartTemplate>
                <MiddleTemplate>
                    <t:MenuItem Text="Profile" RouteName="Profile" Icon="UserCircle" IsActive="{resource: Context.Route.RouteName == "Profile"}" />
                    <t:MenuItem Text="Security" RouteName="Security" Icon="ShieldCheck" IsActive="{resource: Context.Route.RouteName != "Profile"}" />
                </MiddleTemplate>
                <EndTemplate>
                    <t:MenuItem Text="Sign out" NavigateUrl="/" Icon="ArrowRightStartOnRectangle" />
                </EndTemplate>
                <MobileTemplate>
                    <t:MenuItem Text="Profile" RouteName="Profile" Icon="UserCircle" IsActive="{resource: Context.Route.RouteName == "Profile"}" />
                    <t:MenuItem Text="Security" RouteName="Security" Icon="ShieldCheck" IsActive="{resource: Context.Route.RouteName != "Profile"}" />
                    <t:MenuItem Text="Sign out" NavigateUrl="/" Icon="ArrowRightStartOnRectangle" />
                </MobileTemplate>
            </t:TopMenu>
        </TopMenuTemplate>
        <Content>
            <dot:ContentPlaceHolder ID="MainContent" />

            <footer class="app-footer">
                <cc:Mascot class="mascot app-footer-mark" />
                <span>Passkeys demo &middot; DotVVM + ASP.NET Core Identity</span>
            </footer>
        </Content>
    </t:AppLayout>

    <t:Notifications Items="{value: Notifications}" />

    <dot:BodyResourceLinks />
</body>
</html>
